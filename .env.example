# ORCID sandbox configuration, used to record fixtures and run the live test group.
# Copy this file to .env and fill in your sandbox credentials.
# Tests refuse to run against anything other than the sandbox.
ORCID_ENVIRONMENT=sandbox

# Sandbox *member* API client, issued by ORCID to member organisations (basic or premium).
# Not the Public API client from the Developer Tools page: that one cannot write to records.
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=your_client_secret

# A redirect URI registered on your sandbox client, used by bin/sandbox-token.sh.
# It does not need to work: you copy the code from the address bar.
ORCID_REDIRECT_URI=https://localhost/callback

# Sandbox record used for tests and the 3-legged token granted on it
# (scopes: /read-limited /activities/update /person/update).
# Filled in by bin/sandbox-token.sh, see CONTRIBUTING.md.
ORCID_ORCID_ID=0000-0000-0000-0000
ORCID_ACCESS_TOKEN=your_user_access_token
